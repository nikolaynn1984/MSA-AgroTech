@startuml C1_hybrid_cloud
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма (C1)\nАльтернативное решение: гибрид с облачной видеоаналитикой

Person(operative, "Дежурный сотрудник на ферме", "Получает уведомления об инцидентах и реагирует на месте")
Person(operator, "Оператор животноводства", "Контролирует кормление и состояние поголовья, подтверждает алерты")
Person(head, "Руководитель / агроном", "Смотрит сводки, метрики поголовья и потребления корма")
Person(admin, "ИТ-администратор", "Управляет агентами и моделями, получает системные алерты")

System_Boundary(platform, "Платформа мониторинга скота (наша разработка)") {
  System(agentLite, "Лёгкий агент фермы (edge)", "Сбор телеметрии, управление оборудованием, буферизация видео, локальный fallback-алертинг при отсутствии связи")
  System(core, "Центральный сервер", "Агрегация событий и метрик, дашборды, API, постановка задач на облачную аналитику")
}

System_Ext(cloudCV, "Облачный сервис видеоаналитики", "Приём кадров/фрагментов, инференс нейросетевых моделей, возврат событий об инцидентах")
System_Ext(cctv, "IP-камеры (ONVIF/RTSP)", "Съёмка день/ночь, покрытие цехов без слепых зон")
System_Ext(feed, "Кормушки и поилки", "Оборудование разных производителей (Modbus / OPC-UA / MQTT)")
System_Ext(water, "Системы фильтрации воды", "Датчики давления, расхода, состояния фильтров")
System_Ext(models, "CV-модели партнёров", "Готовые нейросетевые модели распознавания поведения животных")
System_Ext(tech, "Система мониторинга техники (существующая)", "Телеметрия парка техники и планирование заданий")
System_Ext(sms, "Шлюз уведомлений (SMS / мессенджер)", "Доставка алертов дежурному на местах")
System_Ext(app, "Мобильное / веб-приложение (планируемое)", "Потребитель будущего API платформы")

Rel(cctv, agentLite, "Видеопотоки", "RTSP")
Rel(feed, agentLite, "Управление и статусы", "Modbus / OPC-UA / MQTT")
Rel(agentLite, water, "Опрос датчиков", "Modbus / MQTT")
Rel(models, cloudCV, "Дистрибутивы моделей", "HTTPS")
Rel(agentLite, cloudCV, "Кадры / фрагменты видео (зависит от качества канала)", "HTTPS / S3")
Rel(cloudCV, core, "События об инцидентах", "HTTP / очередь")
Rel(core, agentLite, "Конфигурации, расписания выгрузки", "MQTT / HTTPS")
Rel(core, app, "REST API (будущее приложение)", "HTTPS")
Rel(agentLite, sms, "Локальные уведомления при отсутствии связи", "SMS / push")
Rel(core, sms, "Централизованные уведомления", "SMS / push")
Rel(core, tech, "Интеграция телеметрии и заданий (опционально)", "REST / шина")
Rel(operator, core, "Контроль и подтверждение алертов", "HTTPS")
Rel(head, core, "Отчёты и метрики", "HTTPS")
Rel(admin, core, "Управление агентами и моделями", "HTTPS")
Rel(operative, agentLite, "Реагирует на инциденты", "Мобильное приложение / локальный интерфейс")
@enduml