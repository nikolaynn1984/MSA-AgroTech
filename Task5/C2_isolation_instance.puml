@startuml

title C2. Изоляция: отдельный инстанс на клиента
actor "Enterprise-клиент" as U
cloud "Облако (Kubernetes)" {
  node "Пространство тенатн-A\n(полный стек платформы)" as IA {
    [Шлюз API ]
    [Сервисы ]
    [БД, CH, S3-пул ]
  }

  node "Пространство тенант-B\n(полный стек платформы)" as IB {
    [Шлюз API]
    [Сервисы]
    [БД, CH, S3-пул]
  }
  [Панель контроля тенантов\n(деплой, обновления)] as CP
}
package "Фермы клиента" {
  [Edge-агенты] as AG
}
U --> IA
AG --> IA
CP ..> IA : деплой/обновления
CP ..> IB
@enduml