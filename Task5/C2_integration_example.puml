@startuml
title C2. Пример интеграции: «АгроТех Х» как клиент SaaS-платформы
actor "Платформа «АгроМонитор»\n(SaaS-оператор)" as OPS

cloud "SaaS-платформа" {
  [Шлюз API] as GW
  [Севвис тенантов\nтенант: АгроТех Х] as TS
  [Мониторинг/аналитика] as MS
  [Billing + Metering] as BL
}

package "Инфраструктура «АгроТех Х»" {
  package "Фермы (150 тепличных комплексов,\nсвиноводческие фермы)" {
    [Edge-агент фермы] as AG
    [Камеры, датчики,\nкормушки/поилки] as DEV
    [Дежурный сотрудник\n(алерты на месте)] as G
  }
  [Центральный сервер\n«АгроТех Х»] as HQ
  [ERP / BI\nсистемы компании] as ERP
}

OPS --> TS : онбординг тенанта
TS --> GW : выдача кредов\nферм и API-ключей
DEV --> AG : подключение оборудования
AG ..> G : локальные алерты\n(SMS/пуш, без интернета)
AG --> GW : MQTT/TLS\nсобытия, метрики
GW --> MS
MS ..> GW : вебхуки\n(обратная доставка событий)
GW --> HQ : REST API\nсобытия/метрики
HQ --> ERP : аналитика\nпоголовья и издержек
MS --> BL : метрики использования\n(биллинг тенанта)
@enduml
