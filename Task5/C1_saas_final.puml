@startuml

title C1. SaaS-платформа мониторинга скота (To-Be)
actor "Клиент-агрохолдинг\n(админ, оператор, дежурный)" as U
actor "Разработчик-интегратор\nклиента" as DEV
actor "Партнёр\n(ML-модели)" as P
actor "Дежурный на ферме" as GUARD

package "SaaS-платформа «АгроМонитор»" {
  [Мультитенантная платформа\nмониторинга скота\n(изоляция, биллинг, API)] as PL
}

package "Клиентская инфраструктура\n(фермы каждого тенанта)" {
  [Камеры, датчики, кормушки/поилки,\nсистемы фильтрации воды] 
  [Edge-агент фермы\n(CV-инференс на месте)] as AG
}

[Платёжные системы\n(ЮKassa, СБП)] as PAY

U --> PL : панель самообслуживания\nREST/JWT
DEV --> PL : открытый API\n+ dev-портал
DEV --> AG : регистрация ферм,\nкреды агентов
DEV <--> AG : телеметрия\nMQTT/TLS
GUARD .. AG : локальные алерты\n(SMS/пуш, без интернета)
P .. PL : обновление\nML-моделей
PL --> PAY : счета, вебхуки\nплатежей
@enduml
